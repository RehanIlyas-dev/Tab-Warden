{
  "name": "tab-warden",
  "version": "0.2.0",
  "private": true,
  "description": "Finds duplicate tabs by URL, lists every open tab grouped by site, closes the copies, and unloads the tabs you left idle.",
  "type": "module",
  "engines": {
    "chrome": ">=120"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vite build && cd dist && zip -r ../tab-warden-0.2.0.zip . -x '.*'",
    "icons": "python3 scripts/make-icons.py",
    "store-assets": "python3 scripts/make-store-assets.py"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.30",
    "vite": "^7.1.7",
    "vitest": "^5.0.3"
  }
}
