{
  "manifest_version": 3,
  "name": "Tab Warden",
  "version": "0.1.1",
  "description": "Finds duplicate tabs by URL, lists every open tab grouped by site, and closes the copies you no longer need.",
  "minimum_chrome_version": "120",
  "permissions": [
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Warden"
  },
  "options_page": "options.html",
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
