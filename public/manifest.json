{
  "manifest_version": 3,
  "name": "Tab Warden",
  "version": "0.1.0",
  "description": "Finds duplicate tabs, ranks tab weight, audits your extensions and reports notification spam.",
  "minimum_chrome_version": "120",
  "permissions": ["tabs", "storage", "notifications", "management"],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Warden"
  },
  "options_page": "options.html",
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}